        <mxCell id="rsv" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Subnet สำรอง (ไม่มี resource)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;RDS บังคับให้ DB subnet group&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;มี subnet อย่างน้อย 2 AZ&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;แม้ใช้ Single-AZ&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00A4A6;fontColor=#222;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="620" y="295" width="220" height="100" as="geometry"/></mxCell>
